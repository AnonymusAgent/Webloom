# ─────────────────────────────────────────────────────────────────────────────
# Webloom — environment configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit a real .env, password, or token to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL connection string used by the application AND Drizzle Kit.
#
# For Neon, use the branch's DIRECT endpoint (without "-pooler"), because this
# application owns a bounded connection pool (max 5) and relies on the role's
# default search_path:
#   postgresql://USER:PASSWORD@ep-xxxx-direct-host/DATABASE?sslmode=require&channel_binding=require
#
# Example (Neon):
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Example (local PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=

# ─── Admin authentication (REQUIRED in production) ───────────────────────────
# Password for the protected /admin dashboard.
# Development fallback is "webloom" — never rely on it in production.
ADMIN_PASSWORD=

# Independent random secret used to sign admin session cookies (HMAC-SHA256).
# Generate one with: openssl rand -base64 48
# Development fallback is "webloom-dev-secret" — never rely on it in production.
ADMIN_SECRET=

# ─── GitHub integration (OPTIONAL) ───────────────────────────────────────────
# Fine-grained personal access token (read-only recommended).
#   - Repository "Metadata: read" → connected-account discovery (/user/repos)
#   - Repository "Contents: read" → README, tree, language, manifest analysis
# Public repository imports work WITHOUT a token; this only enables discovery
# and inspection of authorized private repositories.
GITHUB_TOKEN=

# ─── Site origin (REQUIRED in production) ────────────────────────────────────
# Public canonical origin used by metadata, Open Graph, sitemap, and robots.
# Must match the final deployed URL, e.g. https://webloom.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
